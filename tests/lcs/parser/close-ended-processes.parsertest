%% The global closeEndedProcesses (tests/lcs/core/files/process-list
%% .livecodescript). Its name is no keyword, so what compiled before
%% compiles as it did: a variable or handler of that name, and the custom
%% property of an object.

%TEST CloseEndedProcesses
on parse_test
   local tX
   set the closeEndedProcesses to true
   put the closeEndedProcesses into tX
   if the closeEndedProcesses then beep
   set the closeEndedProcesses of me to tX
   put the closeEndedProcesses of me into tX
   put the closeEndedProcesses["a"] of me into tX
end parse_test
%EXPECT PASS
%SUCCESS
%ENDTEST

%TEST CloseEndedProcessesIsAName
on parse_test
   local closeEndedProcesses
   put 1 into closeEndedProcesses
   put closeEndedProcesses + 1 into closeEndedProcesses
   closeEndedProcesses 1, 2
end parse_test
on closeEndedProcesses pA, pB
end closeEndedProcesses
%EXPECT PASS
%SUCCESS
%ENDTEST
