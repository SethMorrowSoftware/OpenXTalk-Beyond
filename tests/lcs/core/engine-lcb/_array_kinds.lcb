library com.livecode.lcs_tests.core.engine_lcb.array_kinds

-- OXT-Beyond: the LCB half of array-kinds.livecodescript. What each handler
-- returns describes what crossed into LCB: "list(...)" for a List,
-- "array(key:...,...)" for an Array (its keys sorted), and the type of
-- anything else.

private handler KindOf(in pValue as optional any) returns String
	variable tParts as List
	variable tJoined as String
	if pValue is nothing then
		return "nothing"
	else if pValue is a list then
		variable tList as List
		variable tElement as optional any
		put pValue into tList
		repeat for each element tElement in tList
			push KindOf(tElement) onto back of tParts
		end repeat
		combine tParts with "," into tJoined
		return "list(" & tJoined & ")"
	else if pValue is an array then
		variable tArray as Array
		variable tKeys as List
		variable tKey as String
		put pValue into tArray
		put the keys of tArray into tKeys
		sort tKeys in ascending text order
		repeat for each element tKey in tKeys
			push tKey & ":" & KindOf(tArray[tKey]) onto back of tParts
		end repeat
		combine tParts with "," into tJoined
		return "array(" & tJoined & ")"
	else if pValue is a string then
		return "string"
	else if pValue is a number then
		return "number"
	else if pValue is a boolean then
		return "boolean"
	end if
	return "other"
end handler

public handler TestArrayKinds_Any(in pValue as optional any) returns String
	return KindOf(pValue)
end handler

public handler TestArrayKinds_Array(in pValue as Array) returns String
	return KindOf(pValue)
end handler

public handler TestArrayKinds_List(in pValue as List) returns String
	return KindOf(pValue)
end handler

public handler TestArrayKinds_MakeList() returns List
	return [1, [2, 3], [], {"k": [4]}]
end handler

public handler TestArrayKinds_MakeArray() returns Array
	return {"l": [1], "e": [], "a": {"x": 1}}
end handler

end library
