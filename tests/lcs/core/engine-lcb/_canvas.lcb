library com.livecode.lcs_tests.core.canvas

use com.livecode.canvas

public handler CanvasTestPixelHeight()
	variable tCanvas as Canvas
	put a new canvas with size [300,100] into tCanvas
	return the pixel height of tCanvas is 100
end handler

public handler CanvasTestImageFromResourceFile()
	variable tImage as Image
	put image from resource file "tiny.png" into tImage
	
	return not (the pixels of tImage is empty)
end handler

public handler TestCanvas_ImageFromFile(in pPath as String) returns Boolean
	variable tImage as Image
	put image from file pPath into tImage
	-- if image from file fails it will throw
	return true
end handler

public handler CanvasTestFillRule(in pRule as String) returns String
	variable tCanvas as Canvas
	put a new canvas with size [10,10] into tCanvas
	set the fill rule of tCanvas to pRule
	return the fill rule of tCanvas
end handler

public handler CanvasTestJoinStyle(in pStyle as String) returns String
	variable tCanvas as Canvas
	put a new canvas with size [10,10] into tCanvas
	set the join style of tCanvas to pStyle
	return the join style of tCanvas
end handler

public handler CanvasTestCapStyle(in pStyle as String) returns String
	variable tCanvas as Canvas
	put a new canvas with size [10,10] into tCanvas
	set the cap style of tCanvas to pStyle
	return the cap style of tCanvas
end handler

end library
