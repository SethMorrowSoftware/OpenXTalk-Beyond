##################
engine/src/hashedstrings.cpp
engine/src/encodederrors.cpp
engine/src/startupstack.cpp
engine/src/linuxstubs.cpp
lcidlc/src/EncodedSupport.c

# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store\?
._*
.Spotlight-V100
.Trashes
Icon\?
ehthumbs.db
Thumbs.db

# Versioning files #
####################
.svn/

# Project setting files #
#########################
*.pbxuser
*.perspectivev3
xcuserdata/
*.vcproj.*.user
*.ncb
*.suo

# Build folders #
#################
_build/
_cache/
environment_log.txt

# Documentation #
#################
Documentation/html_viewer/resources/data/api*/*.js
Documentation/html_viewer/resources/data/guide/*.js

# Additional externals #
########################
Ext/

# Edition file #
################
edition.txt

# Shipped OpenXTalk Lite files #
################################
# Files of the installed IDE that tools/oxt/layout.py imports but that the
# rules above (or *.xz in the top-level .gitignore) would ignore. They are
# shipped content, so they are tracked; see tools/oxt/README.md.
!Documentation/html_viewer/resources/data/api/api.sqlite
!Documentation/html_viewer/resources/data/api_builder/*.js
!Documentation/html_viewer/resources/data/api_script/*.js
!Documentation/html_viewer/resources/data/guide/*.js
!Documentation/linked_files/*.zip
!Resources/MacOs/*.zip
!Toolset/resources/supporting_files/themes/*.tar.xz
