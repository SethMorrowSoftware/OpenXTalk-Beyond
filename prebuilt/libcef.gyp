{
	'includes':
	[
		'../common.gypi',
	],
	
	# The CEF files a package ships in Externals/CEF: those of the binary
	# distribution that prebuilt/scripts/build-cef.sh (Linux) and
	# prebuilt/build-libraries-windows.ps1 (Windows) unpack, CEF 156.0.26
	# (tools/ci/cef-156-files.txt lists them with their sizes). Not shipped:
	# libcef.lib, which only links, and bootstrap.exe and bootstrapc.exe,
	# CEF's own launchers: the engine starts its own helper process
	# (libbrowser-cefprocess, revbrowser-cefprocess). Each locale has three
	# small variants (_FEMININE, _MASCULINE, _NEUTER) that Chromium reads
	# beside it since CEF 128.
	'targets':
	[
		{
			'target_name': 'libcef',
			'type': 'none',

			'toolsets': ['host', 'target'],
			
			'dependencies':
			[
				'fetch.gyp:fetch',
			],
			
			'direct_dependent_settings':
			{
				'defines':
				[
					'USING_CEF_SHARED=1',
				],
			},
						
			'conditions':
			[
				[
					'OS == "win"',
					{
						'copies':
						[
							{
								'destination': '<(PRODUCT_DIR)/Externals/CEF/',
								'files':
								[
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/chrome_100_percent.pak',
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/chrome_200_percent.pak',
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/chrome_elf.dll',
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/d3dcompiler_47.dll',
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/dxcompiler.dll',
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/icudtl.dat',
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/libcef.dll',
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/resources.pak',
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/v8_context_snapshot.bin',
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/vk_swiftshader.dll',
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/vk_swiftshader_icd.json',
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/vulkan-1.dll',
								],
							},
							{
								'destination': '<(PRODUCT_DIR)/Externals/CEF/locales',
								'files':
								[
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/locales/af.pak',
									'unpacked/cef/<(uniform_arch)-win32-v141_static_$(ConfigurationName)/lib/CEF/locales/af_FEMININE.pak',
